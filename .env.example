POSTGRES_DB=baobia
POSTGRES_USER=baobia
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_HOST_PORT=5432
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mot de passe des comptes de démo (manage.py seed --demo). 8 caractères minimum.
SEED_DEMO_PASSWORD=change-me-demo
# Clé de signature des jetons JWT (32 caractères ou plus). Vide = DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Essais de connexion : par numéro et par adresse IP.
AUTH_LOGIN_PHONE_RATE=5/minute
AUTH_LOGIN_IP_RATE=30/minute
# Nombre de proxys devant Django (0 en local, 1 derrière infra/proxy).
DRF_NUM_PROXIES=0
PHONE_DEFAULT_COUNTRY_CODE=225
